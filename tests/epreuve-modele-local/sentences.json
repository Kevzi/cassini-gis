 {"id": "S11", "text": "Quels bâtiments font plus de 12 mètres de haut ?", "expected": [{"command": "layer.select_by_attribute", "params": {"layer": "batiments_d27a60e8_4b95_4c31_9f7e_8a05d1b3c649", "filter": {"field": "hauteur_m", "operator": "gt", "value": 12}}}], "expect_refusal": false},
