# --- Rust / moteur (core, ai) ---
target/
**/target/
*.pdb

# --- Node / interface Tauri (app) ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# Schemas d'autorisations regeneres par Tauri a chaque construction, et
# differents selon le systeme qui compile : jamais versionnes.
app/src-tauri/gen/schemas/

# --- Donnees telechargees : jamais versionnees (voir CLAUDE.md §5) ---
# /data ne contient que les scripts de telechargement et de preparation.
data/downloads/
data/cache/
data/work/
*.pmtiles
*.mbtiles
*.parquet
*.geoparquet
*.gpkg
*.shp
*.dbf
*.shx
*.prj
*.cpg
*.laz
*.tif
*.tiff
*.jp2

# Exception : les jeux de test de /fixtures sont versionnes, ils sont legers
# et la recette en depend (CLAUDE.md §9).
!fixtures/**

# --- Modeles IA locaux (plusieurs Go, voir CLAUDE.md §3) ---
*.gguf
*.safetensors
*.bin
ai/models/

# --- Outillage BMad : reinstallable, pas versionne ---
# Les skills se reinstallent depuis skills-lock.json (`npx skills install`),
# et les scripts _bmad se regenerent avec `bmad setup`.
.agents/
_bmad/scripts/
_bmad/*/scripts/
# Cache de rendu des skills BMad : regenere a chaque invocation
_bmad/render/
# Reponses personnelles de configuration (non partagees)
*.user.toml

# --- Systeme et editeurs ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

__pycache__/
*.pyc

# Skills BMad installes en local (pas du code Cassini)
.claude/
skills-lock.json

# Notes privees locales (jamais versionnees, voir CLAUDE.md §2.9)
CLAUDE.local.md

# --- Jeu d'exemples d'entrainement (ticket 5.10) : regenere, jamais versionne ---
exemples.jsonl
training/**/*.jsonl
