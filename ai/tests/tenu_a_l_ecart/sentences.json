[
  {
    "id": "H01",
    "text": "Trouve les parcelles constructibles du PLU à moins de 500 m d'une gare à Villeneuve-le-Roi et sors-moi la carte en PDF.",
    "expected": {
      "kind": "calls",
      "calls": [
        {
          "command": "analysis.select_by_attribute",
          "params": {
            "layer_id": "zonage_plu_4c8e19a3_d7b2_4f10_a6e5_92b13c0f7d48",
            "field": "typezone",
            "operator": "eq",
            "value": "U"
          }
        },
        {
          "command": "analysis.buffer",
          "params": {
            "layer_id": "gares_rer_b93d0f12_6e48_4a7c_95d1_e07f2b8c3a64",
            "distance": {
              "value": 500,
              "unit": "m"
            }
          }
        },
        {
          "command": "analysis.intersect",
          "params": {
            "layer_id": "parcelles_cad_7e21b4c9_0a53_4f6e_b812_3d94c5a07e16",
            "overlay_layer_id": "step:1.layer_id"
          }
        },
        {
          "command": "analysis.intersect",
          "params": {
            "layer_id": "step:3.layer_id",
            "overlay_layer_id": "step:2.layer_id"
          }
        },
        {
          "command": "layout.export_pdf",
          "params": {
            "title": "Parcelles constructibles à moins de 500 m d'une gare"
          }
        }
      ]
    },
    "family": "démo exacte"
  },
